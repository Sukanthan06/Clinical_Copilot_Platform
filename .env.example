# Application Settings
APP_NAME="Clinical Copilot Platform"
APP_ENV="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS='["*"]'

# MCP Server URL (NitroCloud SSE Endpoint)
# Get this from your NitroCloud deployment dashboard
MCP_SERVER_URL="https://<your-instance>.app.nitrocloud.ai/sse"
MCP_TIMEOUT=60

# AI / LLM Keys
GEMINI_API_KEY="your-gemini-api-key-here"
GROK_API_KEY="your-groq-api-key-here"

# Vector Database (Pinecone)
PINECONE_API_KEY="your-pinecone-api-key-here"
PINECONE_INDEX="clinical-copilot"
